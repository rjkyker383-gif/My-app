# Never commit real secrets. Copy this file locally to .env and fill values there.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

GITHUB_REPO=rjkyker383-gif/My-app
GITHUB_BRANCH=cycle-5-leases-checkpoints

GEMINI_THREAD_NAME=GEMINI_HOME_THREAD
CHATGPT_THREAD_NAME=CHATGPT_HOME_THREAD
RELAY_INTERVAL_SECONDS=900
RELAY_MAX_RETRIES=3
RELAY_MAX_STALLS=3
RELAY_MEMORY_WINDOW=30
RELAY_MUTATION_MODE=adaptive
RELAY_STATE_PATH=.relay-state/relay.json
